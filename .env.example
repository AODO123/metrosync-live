# MetroSync environment configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/metrosync?retryWrites=true&w=majority

# Secret used to sign JWT tokens
# Generate a strong random string, e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_string

# Port the server listens on (optional, defaults to 3000)
PORT=3000
