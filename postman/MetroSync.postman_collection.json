      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains a JWT token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.role).to.eql('admin');",
                  "    pm.expect(jsonData.email).to.eql('admin@metrosync.com');",
                  "});",
                  "",
                  "// Save the token for use in later requests",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
