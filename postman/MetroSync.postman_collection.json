    {
      "name": "Stations",
      "item": [
        {
          "name": "Get All Stations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of stations\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "    pm.expect(jsonData[0]).to.have.property('name');",
                  "    pm.expect(jsonData[0]).to.have.property('line');",
                  "    pm.expect(jsonData[0]).to.have.property('order');",
                  "});",
                  "",
                  "pm.test(\"Stations are sorted by line then order\", function () {",
                  "    var stations = pm.response.json();",
                  "    for (var i = 1; i < stations.length; i++) {",
                  "        var prev = stations[i - 1];",
                  "        var curr = stations[i];",
                  "        if (prev.line === curr.line) {",
                  "            pm.expect(prev.order).to.be.at.most(curr.order);",
                  "        } else {",
                  "            pm.expect(prev.line).to.be.below(curr.line);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stations",
